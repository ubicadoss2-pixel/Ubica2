generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String     @id @default(uuid())
  code        String     @unique @db.VarChar(50)
  createdAt   DateTime   @default(now()) @map("created_at")
  description String?
  name        String     @db.VarChar(100)
  userRoles   UserRole[]

  @@map("roles")
}

model City {
  id          String   @id @default(uuid())
  countryCode String   @map("country_code") @db.Char(2)
  name        String   @db.VarChar(120)
  stateRegion String?  @map("state_region") @db.VarChar(120)
  timezone    String   @default("America/Bogota") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at")
  places      Place[]

  @@unique([countryCode, name, stateRegion])
  @@map("cities")
}

model PlaceType {
  id        String   @id @default(uuid())
  code      String   @unique @db.VarChar(50)
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")
  places    Place[]

  @@map("place_types")
}

model EventCategory {
  id            String                 @id @default(uuid())
  code          String                 @unique @db.VarChar(50)
  name          String                 @db.VarChar(100)
  createdAt     DateTime               @default(now()) @map("created_at")
  events        Event[]
  userFavorites UserFavoriteCategory[]

  @@map("event_categories")
}

model User {
  id                   String                 @id @default(uuid())
  isActive             Boolean                @default(true) @map("is_active")
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")
  deletedAt            DateTime?              @map("deleted_at")
  email                String                 @unique @db.VarChar(254)
  fullName             String?                @map("full_name") @db.VarChar(160)
  passwordHash         String?                @map("password_hash")
  phone                String?                @db.VarChar(30)
  avatarUrl            String?                @map("avatar_url") @db.VarChar(500)
  birthDate            DateTime?              @map("birth_date") @db.Date
  username             String?                @unique @db.VarChar(100)
  analytics            AnalyticsEvent[]
  auditLogs            AuditLog[]
  chatConversations    ChatConversation[]
  moderatedComments    Comment[]              @relation("CommentModerator")
  comments             Comment[]              @relation("CommentAuthor")
  favorites            Favorite[]
  passwordResetTokens  PasswordResetToken[]
  places               Place[]                @relation("PlaceOwner")
  reports              Report[]
  searchHistory        SearchHistory[]
  blockedUsers         UserBlock[]            @relation("BlockedRelation")
  blockedByUsers       UserBlock[]            @relation("BlockerRelation")
  favoriteCategories   UserFavoriteCategory[]
  history              UserHistory[]
  preferences          UserPreference[]
  userRoles            UserRole[]
  verifications        Verification[]
  reservations         Reservation[]

  @@map("users")
}

model Verification {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  fullName       String   @map("full_name") @db.VarChar(160)
  documentType   String   @map("document_type") @db.VarChar(50)
  documentNumber String   @map("document_number") @db.VarChar(100)
  fileUrl        String   @map("file_url") @db.VarChar(500)
  status         String   @default("PENDING") @db.VarChar(30)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("verifications")
}

model UserRole {
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")
  role      Role     @relation(fields: [roleId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId], map: "user_roles_role_id_fkey")
  @@map("user_roles")
}

model Place {
  id             String            @id @default(uuid())
  ownerUserId    String?           @map("owner_user_id")
  cityId         String            @map("city_id")
  placeTypeId    String            @map("place_type_id")
  name           String            @db.VarChar(180)
  slug           String            @db.VarChar(220)
  description    String?
  addressLine    String?           @map("address_line") @db.VarChar(240)
  neighborhood   String?           @db.VarChar(140)
  latitude       Decimal?          @db.Decimal(9, 6)
  longitude      Decimal?          @db.Decimal(9, 6)
  priceLevel     Int?              @map("price_level")
  status         PlaceStatus       @default(DRAFT)
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  deletedAt      DateTime?         @map("deleted_at")
  postalCode     String?           @map("postal_code") @db.VarChar(20)
  isSponsored    Boolean           @default(false) @map("is_sponsored")
  sponsoredUntil DateTime?         @map("sponsored_until")
  analytics      AnalyticsEvent[]
  comments       Comment[]
  events         Event[]
  favorites      Favorite[]
  openingHours   OpeningHour[]
  contacts       PlaceContact[]
  photos         PlacePhoto[]
  socialLinks    PlaceSocialLink[]
  city           City              @relation(fields: [cityId], references: [id])
  ownerUser      User?             @relation("PlaceOwner", fields: [ownerUserId], references: [id])
  placeType      PlaceType         @relation(fields: [placeTypeId], references: [id])
  offers         Offer[]
  reports        Report[]
  reservations   Reservation[]

  @@unique([cityId, slug])
  @@index([cityId, placeTypeId])
  @@index([status])
  @@index([latitude, longitude])
  @@index([ownerUserId], map: "places_owner_user_id_fkey")
  @@index([placeTypeId], map: "places_place_type_id_fkey")
  @@map("places")
}

model PlaceContact {
  id          String           @id @default(uuid())
  placeId     String           @map("place_id")
  contactType PlaceContactType @map("contact_type")
  label       String?          @db.VarChar(80)
  value       String           @db.VarChar(240)
  isPrimary   Boolean          @default(false) @map("is_primary")
  createdAt   DateTime         @default(now()) @map("created_at")
  place       Place            @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@index([placeId])
  @@map("place_contacts")
}

model PlaceSocialLink {
  id        String              @id @default(uuid())
  placeId   String              @map("place_id")
  platform  PlaceSocialPlatform
  url       String              @db.VarChar(400)
  createdAt DateTime            @default(now()) @map("created_at")
  place     Place               @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@index([placeId])
  @@map("place_social_links")
}

model PlacePhoto {
  id        String   @id @default(uuid())
  placeId   String   @map("place_id")
  url       String   @db.Text
  altText   String?  @map("alt_text") @db.VarChar(200)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  place     Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@index([placeId])
  @@map("place_photos")
}

model OpeningHour {
  id        String    @id @default(uuid())
  placeId   String    @map("place_id")
  weekday   Int
  openTime  DateTime? @map("open_time") @db.Time(0)
  closeTime DateTime? @map("close_time") @db.Time(0)
  isClosed  Boolean   @default(false) @map("is_closed")
  createdAt DateTime  @default(now()) @map("created_at")
  place     Place     @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([placeId, weekday])
  @@map("opening_hours")
}

model Event {
  id             String             @id @default(uuid())
  createdAt      DateTime           @default(now()) @map("created_at")
  categoryId     String?            @map("category_id")
  currency       String             @default("COP") @db.Char(3)
  deletedAt      DateTime?          @map("deleted_at")
  description    String?
  dressCode      String?            @map("dress_code") @db.VarChar(120)
  endTime        DateTime?          @map("end_time") @db.Time(0)
  minAge         Int?               @map("min_age")
  placeId        String             @map("place_id")
  priceFrom      Decimal?           @map("price_from") @db.Decimal(12, 2)
  priceTo        Decimal?           @map("price_to") @db.Decimal(12, 2)
  startTime      DateTime           @map("start_time") @db.Time(0)
  status         EventStatus        @default(PENDING)
  title          String             @db.VarChar(200)
  updatedAt      DateTime           @updatedAt @map("updated_at")
  isSponsored    Boolean            @default(false) @map("is_sponsored")
  sponsoredUntil DateTime?          @map("sponsored_until")
  analytics      AnalyticsEvent[]
  comments       Comment[]
  photos         EventPhoto[]
  recurrence     EventRecurrence?
  specialDates   EventSpecialDate[]
  category       EventCategory?     @relation(fields: [categoryId], references: [id])
  place          Place              @relation(fields: [placeId], references: [id], onDelete: Cascade)
  reports        Report[]

  @@index([placeId])
  @@index([categoryId])
  @@index([status])
  @@map("events")
}

model EventRecurrence {
  eventId   String   @id @map("event_id")
  weekday   Int
  createdAt DateTime @default(now()) @map("created_at")
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_recurrences")
}

model EventPhoto {
  id        String   @id @default(uuid())
  eventId   String   @map("event_id")
  url       String   @db.Text
  altText   String?  @map("alt_text") @db.VarChar(200)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_photos")
}

model EventSpecialDate {
  id        String        @id @default(uuid())
  eventId   String        @map("event_id")
  eventDate DateTime      @map("event_date") @db.Date
  dateType  EventDateType @default(OCCURRENCE) @map("date_type")
  note      String?       @db.VarChar(250)
  createdAt DateTime      @default(now()) @map("created_at")
  event     Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, eventDate, dateType])
  @@index([eventDate])
  @@index([eventId])
  @@map("event_special_dates")
}

model Favorite {
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  placeId   String   @map("place_id")
  isVisited Boolean  @default(false) @map("is_visited")
  place     Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, placeId])
  @@index([placeId], map: "favorites_place_id_fkey")
  @@map("favorites")
}

model Report {
  id         String           @id @default(uuid())
  userId     String?          @map("user_id")
  createdAt  DateTime         @default(now()) @map("created_at")
  details    String?
  eventId    String?          @map("event_id")
  placeId    String?          @map("place_id")
  reason     ReportReason
  resolvedAt DateTime?        @map("resolved_at")
  status     ReportStatus     @default(OPEN)
  targetType ReportTargetType @map("target_type")
  event      Event?           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  place      Place?           @relation(fields: [placeId], references: [id], onDelete: Cascade)
  user       User?            @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([placeId])
  @@index([eventId])
  @@index([userId], map: "reports_user_id_fkey")
  @@map("reports")
}

model Comment {
  id            String        @id @default(uuid())
  userId        String        @map("user_id")
  placeId       String?       @map("place_id")
  eventId       String?       @map("event_id")
  content       String        @db.VarChar(1000)
  status        CommentStatus @default(VISIBLE)
  moderatedById String?       @map("moderated_by_id")
  moderatedAt   DateTime?     @map("moderated_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  deletedAt     DateTime?     @map("deleted_at")
  rating        Int?          @db.TinyInt
  likes         Int           @default(0)
  event         Event?        @relation(fields: [eventId], references: [id])
  moderatedBy   User?         @relation("CommentModerator", fields: [moderatedById], references: [id])
  place         Place?        @relation(fields: [placeId], references: [id])
  user          User          @relation("CommentAuthor", fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
  @@index([placeId])
  @@index([eventId])
  @@index([moderatedById])
  @@map("comments")
}

model AnalyticsEvent {
  id         String             @id @default(uuid())
  userId     String?            @map("user_id")
  eventType  AnalyticsEventType @map("event_type")
  placeId    String?            @map("place_id")
  eventId    String?            @map("event_id")
  meta       Json?
  occurredAt DateTime           @default(now()) @map("occurred_at")
  event      Event?             @relation(fields: [eventId], references: [id])
  place      Place?             @relation(fields: [placeId], references: [id])
  user       User?              @relation(fields: [userId], references: [id])

  @@index([occurredAt])
  @@index([placeId])
  @@index([eventId])
  @@index([userId], map: "analytics_events_user_id_fkey")
  @@map("analytics_events")
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?  @map("actor_user_id")
  entityId    String   @map("entity_id")
  action      String   @db.VarChar(60)
  entityType  String   @map("entity_type") @db.VarChar(30)
  beforeData  Json?    @map("before_data")
  afterData   Json?    @map("after_data")
  createdAt   DateTime @default(now()) @map("created_at")
  actorUser   User?    @relation(fields: [actorUserId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([actorUserId], map: "audit_logs_actor_user_id_fkey")
  @@map("audit_logs")
}

model UserPreference {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  key       String   @db.VarChar(60)
  value     String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
  @@map("user_preferences")
}

model UserFavoriteCategory {
  id         String        @id @default(uuid())
  userId     String        @map("user_id")
  categoryId String        @map("category_id")
  createdAt  DateTime      @default(now()) @map("created_at")
  category   EventCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
  @@index([userId])
  @@index([categoryId], map: "user_favorite_categories_category_id_fkey")
  @@map("user_favorite_categories")
}

model UserHistory {
  id       String   @id @default(uuid())
  userId   String   @map("user_id")
  itemId   String   @map("item_id")
  itemType String   @map("item_type") @db.VarChar(20)
  viewedAt DateTime @default(now()) @map("viewed_at")
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, viewedAt])
  @@index([userId])
  @@map("user_history")
}

model SearchHistory {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  query        String   @db.VarChar(255)
  cityId       String?  @map("city_id")
  placeTypeId  String?  @map("place_type_id")
  latitude     Decimal? @db.Decimal(9, 6)
  longitude    Decimal? @db.Decimal(9, 6)
  radiusKm     Float?   @map("radius_km")
  resultsCount Int?     @map("results_count")
  createdAt    DateTime @default(now()) @map("created_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId])
  @@map("search_history")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  token     String    @unique @db.VarChar(120)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Offer {
  id          String      @id @default(uuid())
  placeId     String      @map("place_id")
  title       String      @db.VarChar(200)
  description String?     @db.Text
  conditions  String?     @db.Text
  imageUrl    String?     @map("image_url") @db.LongText
  startDate   DateTime    @map("start_date")
  endDate     DateTime    @map("end_date")
  status      OfferStatus @default(ACTIVE)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  
  place       Place       @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@index([placeId])
  @@index([status])
  @@index([startDate, endDate])
  @@map("offers")
}

model ChatConversation {
  id        String        @id @default(uuid())
  userId    String        @map("user_id")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@index([userId])
  @@map("chat_conversations")
}

model ChatMessage {
  id             String           @id @default(uuid())
  conversationId String           @map("conversation_id")
  role           String           @db.VarChar(20)
  content        String           @db.Text
  metadata       Json?
  createdAt      DateTime         @default(now()) @map("created_at")
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("chat_messages")
}

model UserBlock {
  id        String   @id @default(uuid())
  blockerId String   @map("blocker_id")
  blockedId String   @map("blocked_id")
  reason    String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  blocked   User     @relation("BlockedRelation", fields: [blockedId], references: [id], onDelete: Cascade)
  blocker   User     @relation("BlockerRelation", fields: [blockerId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
  @@map("user_blocks")
}

model PaymentTransaction {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  amount     Decimal  @db.Decimal(10, 2)
  targetType String   @map("target_type") @db.VarChar(50)
  targetId   String   @map("target_id")
  status     String   @default("COMPLETED") @db.VarChar(50)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([targetId])
  @@map("payment_transactions")
}

model Reservation {
  id           String   @id @default(uuid())
  placeId      String   @map("place_id")
  userId       String?  @map("user_id")
  guestName    String   @map("guest_name") @db.VarChar(200)
  date         String   @db.VarChar(50)
  time         String   @db.VarChar(50)
  guests       Int
  reason       String?  @db.VarChar(100)
  observations String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  place        Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([placeId])
  @@index([userId])
  @@map("reservations")
}

enum PlaceStatus {
  DRAFT
  PUBLISHED
  SUSPENDED
}

enum PlaceContactType {
  WHATSAPP
  PHONE
  EMAIL
  WEBSITE
}

enum PlaceSocialPlatform {
  INSTAGRAM
  FACEBOOK
  TIKTOK
  X
  YOUTUBE
  OTHER
}

enum EventStatus {
  DRAFT
  PENDING
  ACTIVE
  REJECTED
  CANCELLED
  SUSPENDED
  FINISHED
}

enum EventDateType {
  OCCURRENCE
  EXCEPTION
}

enum ReportTargetType {
  PLACE
  EVENT
}

enum ReportReason {
  WRONG_INFO
  SPAM
  INAPPROPRIATE
  CLOSED
  OTHER
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
}

enum CommentStatus {
  VISIBLE
  EDITED
  HIDDEN
  BLOCKED
}

enum AnalyticsEventType {
  PLACE_VIEW
  EVENT_VIEW
  CONTACT_CLICK
  FAVORITE_ADD
  FAVORITE_REMOVE
  REPORT_CREATE
}

enum OfferStatus {
  ACTIVE
  INACTIVE
}
